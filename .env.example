# Required only when generating questions. Keep the real value server-side.
NVIDIA_API_KEY=

# Confirm the model is available to your NVIDIA account before deployment.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional provider configuration.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_JSON_MODE=prompt

# Temporary local-only developer dashboard. Production always disables it.
ENABLE_DEV_MONITOR=false
